# Origin frontend yang diizinkan (CORS), dipisah koma.
# Dev Vite default sudah dicover; tambah domain produksi saat deploy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase (dipakai fitur IoT untuk menulis/membaca tabel iot_vitals).
# Ambil dari Supabase Dashboard > Project Settings > API.
# SERVICE_ROLE_KEY = kunci service_role (atau secret key sb_secret_...), HANYA untuk backend.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Kunci bersama gelang IoT. Firmware mengirimnya di header X-Device-Key
# ke POST /iot/vitals. Buat acak & panjang, mis.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
IOT_DEVICE_KEY=JzhkOvdV-VTMIPvIVYzUIPAlRl2XDCuARdEr3T0KMp8
